# =============================================================================
# Sellbit — переменные окружения фронтенда (Vite)
# =============================================================================
# Скопируйте в .env и заполните. Все VITE_* попадают в клиентский бандл.
# Никогда не коммитьте .env с реальными ключами.
# =============================================================================

# --- Обязательные ---
# URL проекта Supabase (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anon (public) key Supabase — доступен в клиенте, ограничен RLS
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- Опциональные: уведомления о заявках на пополнение в Telegram ---
# Рекомендуемый способ для продакшена: URL бота, на который сайт шлёт POST.
# Токен остаётся только на сервере бота.
VITE_DEPOSIT_NOTIFY_URL=https://your-bot.example.com/api/deposit-notify

# Альтернатива только для разработки: прямая отправка с клиента через Bot API.
# ВНИМАНИЕ: токен будет виден в коде — для продакшена не использовать.
# Включить явно: VITE_DEV_DIRECT_TG=true и задать токен и ID канала ниже.
# VITE_DEV_DIRECT_TG=true
# VITE_TELEGRAM_BOT_TOKEN=123456:ABC...
# VITE_DEPOSIT_CHANNEL_ID=-1001234567890

# --- Опциональные: API бота (deal-opened, referral-spot-buy, referral-stake) ---
# Базовый URL бота без пути (например https://your-bot.example.com).
# Если не задан, берётся хост из VITE_DEPOSIT_NOTIFY_URL.
# VITE_BOT_API_URL=https://your-bot.example.com

# --- Опциональные: прочее ---
# URL веб-приложения (лендинг, ссылки «Открыть приложение»).
# VITE_WEBAPP_URL=https://your-app.example.com
